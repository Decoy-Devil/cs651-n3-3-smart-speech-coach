# Local development settings. Copy to backend/.env and fill in your key.
# backend/.env is git-ignored and excluded from Cloud Run uploads (.gcloudignore).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001
allowedOrigins=http://localhost:5173,http://127.0.0.1:5173
askAnythingPrompt="You answer questions about Smart Speech Coach, a service that helps people practice speeches, improve delivery, organize ideas, reduce speaking anxiety, and get simple coaching feedback using machine learning. If the user asks about something unrelated, briefly steer them back to Smart Speech Coach. Keep the answer to 1-4 sentences."
