# Copy to frontend/.env. Restart `npm run dev` (or rebuild) after changing it.
# Y = call the backend deployed on Cloud Run; anything else = call the local backend.
VITE_SERVER_REMOTE=Y
VITE_SERVER_URL_REMOTE=https://smart-speech-coach-backend-xxxxxxxxxx.us-west1.run.app
VITE_SERVER_URL_LOCAL=http://localhost:3001
